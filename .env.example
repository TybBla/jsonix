# Klient OpenAI-kompatybilny. Dostawca i serwery MUSZA byc w UE/EOG.
# Rekomendacja: Mistral AI, endpoint regionalny UE, Ministral 3 8B (Apache 2.0).
# Przed oddaniem sprawdz: GET https://api.eu.mistral.ai/v1/models zawiera wybrany model.
LLM_BASE_URL=https://api.eu.mistral.ai/v1
LLM_MODEL=ministral-8b-latest
LLM_API_KEY=wklej-klucz
# Warianty: ministral-3b-latest (wiecej pkt za rozmiar, sprawdzic jakosc)
